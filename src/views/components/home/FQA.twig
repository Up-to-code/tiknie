{# faq.twig #}
<style>
  :root {
    --primary-color: #4F46E5;
    --primary-light: #E0E7FF;
    --hover-color: #4338CA;
  }

  .faq-answer {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.3s ease-out;
  }
  
  .faq-answer.open {
    max-height: 300px;
    opacity: 1;
  }
  
  .rotate-180 {
    transform: rotate(180deg);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<div class="container mx-auto px-4 py-8 theme-purple">
  <div class="max-w-6xl mx-auto">
    <div class="faq-grid">
      {% for faq in component.fqa %}
        <div class="bg-white rounded-lg border border-gray-200 hover:border-primary transition-colors h-fit">
          <button
            class="w-full p-4 text-left focus:outline-none focus:ring-2 rounded-lg flex justify-between items-center group"
            onclick="toggleFAQ(this)"
            aria-expanded="false">
            <span class="font-medium">{{ faq.title }}</span>
            <div class="w-6 h-6 rounded-full bg-[var(--primary-light)] flex items-center justify-center shrink-0 ml-2">
              <svg 
                class="w-4 h-4 text-[var(--primary-color)] transition-transform duration-200"
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24">
                <path 
                  stroke-linecap="round" 
                  stroke-linejoin="round" 
                  stroke-width="2" 
                  d="M12 6v12m6-6H6"/>
              </svg>
            </div>
          </button>
          <div class="faq-answer">
            <div class="px-4 pb-4 text-gray-600">
              {{ faq.sub_title }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  function toggleFAQ(button) {
    const answer = button.nextElementSibling;
    const icon = button.querySelector('svg');
    const isOpen = answer.classList.toggle('open');
    
    // Update plus/minus icon
    if (isOpen) {
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"/>';
    } else {
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/>';
    }
    
    // Close other FAQs
    document.querySelectorAll('.faq-answer').forEach(item => {
      if (item !== answer) {
        const itemButton = item.previousElementSibling;
        const itemIcon = itemButton.querySelector('svg');
        
        item.classList.remove('open');
        itemButton.setAttribute('aria-expanded', 'false');
        itemIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/>';
      }
    });
    
    button.setAttribute('aria-expanded', isOpen);
  }
</script>