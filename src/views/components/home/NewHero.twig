<salla-slider id="thumbs" show-controls="true" type="thumbs" autoplay="true" loop="true">
  <div slot="items">
    {% for item in component.slider %}
    <div
      class="swiper-slide relative bg-no-repeat bg-cover bg-center h-96 overflow-hidden group"
      style="background-image: url('{{ item.image }}');"
    >
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center text-white px-4"
      >
        <h3 class="text-2xl md:text-4xl font-bold drop-shadow-md">{{ item.title }}</h3>
        <a
          href="{{ item.url }}"
          class="inline-block px-4 py-2 bg-white text-black rounded-full shadow-md mt-4 hover:bg-black hover:text-white transition duration-300"
        >
          {{ item.button_text }}
        </a>
      </div>
    </div>
    {% endfor %}
  </div>
</salla-slider>

<!-- Additional Styles -->
<style>
  salla-slider {
    direction: rtl;
  }
</style>
