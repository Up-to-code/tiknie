<salla-slider
  id="thumbs"
  type="thumbs"
  autoplay="true"
  loop="true"
  show-controls="false"
>
  <div slot="items">
    {% for item in component.slider %}
    <div
      class="swiper-slide relative bg-no-repeat bg-cover bg-center h-96 overflow-hidden group"
      style="background-image: url('{{ item.bg_image }}');"
    >
      <div class="container mx-auto flex justify-center items-center h-full">
        <div class="flex flex-col md:flex-row justify-center items-center text-center gap-8">
          <!-- Arabic Text Section -->
          <div class="text-right w-full md:w-1/3 space-y-7 px-5">
            <h1 class="text-5xl font-bold text-black leading-16">{{ item.title }}</h1>
            <a
              href="{{ item.url }}"
              class="inline-block px-8 py-3 bg-primary text-white font-bold rounded-full transition-all duration-300 transform hover:scale-105 hover:shadow-lg hover:bg-gradient-to-r from-primary to-secondary"
            >
              {{ item.title_of_button }}
            </a>
          </div>
          <!-- Image Section -->
          <div class="w-full md:w-2/3 h-96 flex justify-center items-center mobile-hidden">
            <img
              src="{{ item.image }}"
              alt="{{ item.title }}"
              class="w-auto h-full max-w-full object-contain"
            />
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</salla-slider>

<!-- Additional Styles -->
<style>
  .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }
  /* Custom Button Styles */
  .transition-all {
    transition-property: all;
  }
  .duration-300 {
    transition-duration: 300ms;
  }
  .transform {
    transform: translateZ(0);
  }
  .hover\:scale-105:hover {
    transform: scale(1.05); /* Slightly scale up on hover */
  }

  /* Hide image on mobile devices */
  @media (max-width: 768px) {
    .mobile-hidden {
      display: none;
    }
    .text-right {
      text-align: center;
      width: 100% !important;
    }
  }
</style>