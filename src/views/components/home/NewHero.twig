<salla-slider id="thumbs" show-controls="true" type="thumbs">
  <div slot="items">
    {% for item in component.slider %}
    <div
      class="swiper-slide relative bg-no-repeat bg-cover bg-center h-96"
      style="background-image: url('{{ item.image }}');"
    >
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center text-white"
      >
        <h3 class="text-4xl font-bold">{{ item.title }}</h3>
        <p class="text-2xl">{{ item.subtitle }}</p>
        <a
          href="{{ item.url }}"
          class="text-white font-medium mt-4 hover:underline"
          >{{ item.button_text }}</a
        >
      </div>
    </div>
    {% endfor %}
  </div>
</salla-slider>
