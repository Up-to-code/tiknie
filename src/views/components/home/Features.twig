<section class="container  px-4   ">
    <div class="flex flex-wrap mx-auto gap-4 md:gap-8 my-8">
      {% for item in component.features %}
        <div class="bg-white rounded-lg shadow-md overflow-hidden px-2">
          <div class="p-4">
            <img 
              src="{{ item.image }}" 
              alt="{{ item.title }}"
              class="w-10 h-10 object-cover my-2"
            >
            <h2 class="text-xl font-semibold mb-2">{{ item.title }}</h2>
            <p class="text-gray-600">{{ item.sub_title }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>