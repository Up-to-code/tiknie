{# faq.twig #}

<style>
  .faq-answer {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
  }

  .faq-answer.open {
    max-height: 300px;
    opacity: 1;
  }

  .rotate-180 {
    transform: rotate(180deg);
  }
</style>

<div class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mx-auto">
    {# Left Column #}
    <div class="bg-white rounded-lg shadow">
      {% for faq in component.fqa %}
        <div class="border-b border-gray-200 last:border-0">
          <button
            class="w-full py-4 px-6 text-left hover:bg-gray-50 focus:outline-none flex justify-between items-center group"
            onclick="toggleFAQ(this)"
            aria-expanded="false">
            <span class="font-medium text-lg">{{ faq.question }}</span>
            <svg class="w-5 h-5 transform transition-transform duration-300 ease-in-out group-hover:text-blue-500"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <div class="px-6 py-4">
              <p class="text-gray-600">{{ faq.answer }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  function toggleFAQ(button) {
    const answer = button.nextElementSibling;
    const arrow = button.querySelector('svg');
    const isOpen = answer.classList.toggle('open');

    // Close other open FAQs
    document.querySelectorAll('.faq-answer').forEach(item => {
      if (item !== answer) {
        item.classList.remove('open');
        item.previousElementSibling.querySelector('svg').classList.remove('rotate-180');
        item.previousElementSibling.setAttribute('aria-expanded', 'false');
      }
    });

    arrow.classList.toggle('rotate-180', isOpen);
    button.setAttribute('aria-expanded', isOpen);
  }
</script>
