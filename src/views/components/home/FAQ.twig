{# faq.twig #}
{% set faqs = [
    {
      'question': 'What services do you offer?',
      'answer': 'We offer a comprehensive range of services including web development, mobile app development, UI/UX design, and digital marketing solutions.'
    },
    {
      'question': 'How can I get started?',
      'answer': 'Getting started is easy! Simply reach out through our contact form or give us a call. We\'ll schedule a consultation to discuss your needs.'
    },
    {
      'question': 'What are your working hours?',
      'answer': 'Our team is available Monday through Friday, 9:00 AM to 6:00 PM EST. We also provide 24/7 support for urgent matters.'
    },
    {
      'question': 'Do you offer custom solutions?',
      'answer': 'Yes! We specialize in creating custom solutions tailored to your specific needs and requirements. Each project is unique and receives personalized attention.'
    }
  ] %}
  
  <style>
    .faq-answer {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: all 0.3s ease-out;
    }
    
    .faq-answer.open {
      max-height: 300px;
      opacity: 1;
      transition: all 0.3s ease-in;
    }
  </style>
  
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mx-auto">
      {# Left Column #}
      <div class="bg-white rounded-lg shadow">
        {% for faq in faqs|slice(0, 2) %}
          <div class="border-b border-gray-200 last:border-0">
            <button class="w-full py-4 px-6 text-left hover:bg-gray-50 focus:outline-none flex justify-between items-center group" onclick="toggleFAQ(this)">
              <span class="font-medium text-lg">{{ faq.question }}</span>
              <svg class="w-5 h-5 transform transition-transform duration-300 ease-in-out group-hover:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="faq-answer">
              <div class="px-6 py-4">
                <p class="text-gray-600">{{ faq.answer }}</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
  
      {# Right Column #}
      <div class="bg-white rounded-lg shadow">
        {% for faq in faqs|slice(2, 2) %}
          <div class="border-b border-gray-200 last:border-0">
            <button class="w-full py-4 px-6 text-left hover:bg-gray-50 focus:outline-none flex justify-between items-center group" onclick="toggleFAQ(this)">
              <span class="font-medium text-lg">{{ faq.question }}</span>
              <svg class="w-5 h-5 transform transition-transform duration-300 ease-in-out group-hover:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="faq-answer">
              <div class="px-6 py-4">
                <p class="text-gray-600">{{ faq.answer }}</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  
  <script>
    function toggleFAQ(button) {
      // Close all other FAQs
      const allAnswers = document.querySelectorAll('.faq-answer');
      const allArrows = document.querySelectorAll('svg');
      
      allAnswers.forEach((item) => {
        if (item !== button.nextElementSibling && item.classList.contains('open')) {
          item.classList.remove('open');
          const parentButton = item.previousElementSibling;
          const arrow = parentButton.querySelector('svg');
          arrow.style.transform = 'rotate(0deg)';
        }
      });
  
      // Toggle current FAQ
      const answer = button.nextElementSibling;
      const arrow = button.querySelector('svg');
      
      answer.classList.toggle('open');
      
      if (!answer.classList.contains('open')) {
        arrow.style.transform = 'rotate(0deg)';
      } else {
        arrow.style.transform = 'rotate(180deg)';
      }
    }
  </script>